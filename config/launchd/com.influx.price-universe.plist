<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.influx.price-universe</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>bash /Users/masaaki_nagasawa/Desktop/biz/influx/scripts/price_universe_run.sh</string>
    </array>

    <!-- 毎週月曜 08:30（Weekday 1=月）。SCFIは金曜公表・TEは日次更新なので週明けに前週分が揃う -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/masaaki_nagasawa/.claude/state/price-universe.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/masaaki_nagasawa/.claude/state/price-universe.err.log</string>
</dict>
</plist>
