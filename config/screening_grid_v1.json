 "features": [
  {
   "name": "dev200",
   "source": "kpi_sue_champion_signals.compute_dev200",
   "threshold_provenance": "第11周 volshock_x_above200（dev200>0）で使用済みの既存閾値",
   "buckets": [
    {
     "label": "above",
     "cond": "dev200 > 0"
    },
    {
     "label": "below",
     "cond": "dev200 <= 0"
    }
   ]
  },
  {
   "name": "quiet_ratio",
   "source": "kpi_volshock_v2_amplifiers.compute_quiet_ratio",
   "threshold_provenance": "第13周 v2-2（quiet_ratio>=1.2）の既存閾値",
   "buckets": [
    {
     "label": "quiet",
     "cond": "quiet_ratio >= 1.2"
    },
    {
     "label": "noisy",
     "cond": "quiet_ratio < 1.2"
    }
   ]
  },
  {
   "name": "ul_count_10bd",
   "source": "kpi_volshock_v3_ul_earnings.compute_ul_count_10bd",
   "threshold_provenance": "第16周 A2（ul<=2）の既存閾値",
