    }
   ],
   "note": "regime=='unknown'は両バケットから除外"
  },
  {
   "name": "membership",
   "source": "output/base_rate/universes_w21.csv.gz を (universe_month_used, code) で結合",
   "threshold_provenance": "§6手順5の入替バイアス分解（新規流入2倍効果）の既存区分",
   "buckets": [
    {
     "label": "new",
     "cond": "membership == 'new'"
    },
    {
     "label": "existing",
     "cond": "membership == 'existing'"
    }
   ]
  }
 ],
