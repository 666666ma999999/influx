    }
   ]
  },
  {
   "name": "max20",
   "source": "kpi_pead_signals.compute_max20",
   "threshold_provenance": "第2周 T2（max20 0.10）の既存閾値",
   "buckets": [
    {
     "label": "spiked",
     "cond": "max20 >= 0.10"
    },
    {
     "label": "calm",
     "cond": "max20 < 0.10"
    }
   ]
  },
  {
   "name": "regime",
   "source": "returns.csv regime列（measure_base_rate.build_regime_series由来）",
   "threshold_provenance": "§6既存のTOPIX-SMA200レジーム定義",
   "buckets": [
