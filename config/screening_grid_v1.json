 "screen_rules": {
  "eligibility": {
   "min_n": 50,
   "min_months_spanned": 12,
   "order": "eligibility判定はp値計算より前に適用（非eligibleセルもn・月数・特徴量欠損率を記録するがp値は計算しない）"
  },
  "p_value": "帰無中心化・月次ブロック・ブートストラップの片側p値: 観測EVをEV_obsとし、ret列を(ret - EV_obs - cost調整の平均が0になるよう)中心化した系列に対して月ブロック復元抽出（bootstrap_ev_ciと同一の月ブロック方式・n_boot=20000・seed=42）でEV*分布を作り、p = (1 + #{EV* >= EV_obs}) / (n_boot + 1)。Monte Carlo標準誤差を併記",
  "selection_primary": "eligible かつ 非reference_only の全セルを1家族として BH-FDR q=0.10 → 有意セルのうちlift点推定>1.0 → p昇順で上限8セル。同値pのtie-breakは (population名, feature名, bucket名) の辞書順",
  "selection_sensitivity": "BY補正（Benjamini-Yekutieli・依存構造への保守側）の結果を全セルに併記。BH通過・BY非通過のセルは『統計的発見』と呼ばず『優先順位付け通過』とのみ記載",
  "seed_sensitivity": "seed=42とseed=43で生存セル集合が一致することを機械確認。不一致ならn_bootを5万に上げて再判定。5万でも不一致ならFATAL停止しユーザー報告（結果の採用禁止）。この escalation 自体を凍結手順とする（Codexレビュー⑫の補強反映・実行前凍結）",
  "ev_definition": "EV(なし・往復コスト0.3%控除) = mean(ret) - 0.003（returns.csvのret列は生値・Decision Log #5の規約どおり）"
 },
 "confirm_rules": {
  "framing": "historical validation（内部検証）— 統計的な独立確認ではない。合格の意味は『前向き検証（ペーパートレード等）への優先順位付け資格』に限定",
  "criteria": "生存セル数をSとし、確認半期で (a) 帰無中心化・片側p <= 0.05/S（Bonferroni同時補正・screen_rulesと同一のp値機構・n_boot=20000・seed=42） (b) lift点推定 > 1.0 (c) n_confirm >= 30 — 3条件すべてで確認合格。個別95%CIは参考併記に格下げ",
